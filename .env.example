# =============================================================================
# IDENT AFRICA - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env files with real secrets to version control

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV="development"                    # development | production
PORT=3000                                 # Server port

# Allowed CORS origins (comma-separated)
# For production, list your deployed domain(s)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# JWT secret for signing tokens (REQUIRED in production)
# Generate a strong random string: openssl rand -base64 64
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"

# Session expiry in seconds (default: 86400 = 24 hours)
JWT_EXPIRY="86400"

# -----------------------------------------------------------------------------
# AI Services
# -----------------------------------------------------------------------------
# Required for AI Safari Planner functionality
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# -----------------------------------------------------------------------------
# External URLs
# -----------------------------------------------------------------------------
# The public URL where this application is hosted
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# For local development, leave empty to use mock data
# For production, use a PostgreSQL connection string
# Example: postgresql://user:password@host:5432/ident_africa
DATABASE_URL=""

# -----------------------------------------------------------------------------
# Stripe Payment Gateway (production)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY="sk_live_xxxxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxxxx"
# STRIPE_PUBLISHABLE_KEY="pk_live_xxxxx"

# -----------------------------------------------------------------------------
# Flutterwave Payment Gateway (production)
# -----------------------------------------------------------------------------
# FLUTTERWAVE_PUBLIC_KEY="FLWPUBK-xxxxx"
# FLUTTERWAVE_SECRET_KEY="FLWSECK-xxxxx"
# FLUTTERWAVE_WEBHOOK_SECRET="xxxxx"

# -----------------------------------------------------------------------------
# M-Pesa (Safaricom API - Kenya)
# -----------------------------------------------------------------------------
# MPESA_CONSUMER_KEY="xxxxx"
# MPESA_CONSUMER_SECRET="xxxxx"
# MPESA_SHORTCODE="123456"
# MPESA_PASSKEY="xxxxx"
# MPESA_CALLBACK_URL="https://yourdomain.com/api/payments/mpesa/callback"
# MPESA_ENV="sandbox"  # sandbox | live

# -----------------------------------------------------------------------------
# Logging & Monitoring
# -----------------------------------------------------------------------------
# LOG_LEVEL="info"                         # debug | info | warn | error
# SENTRY_DSN=""                            # For error tracking (Sentry)
