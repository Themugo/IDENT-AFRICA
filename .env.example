# =============================================
# IDENT AFRICA - Environment Configuration
# =============================================

# ==================== APP CONFIG ====================
# APP_URL: The URL where the application is hosted
APP_URL="https://identafrica.com"
NODE_ENV="production"
PORT=3000

# ==================== API KEYS ====================
# Gemini AI for Safari Planner
GEMINI_API_KEY="your_gemini_api_key"

# Stripe Payment Gateway
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# M-Pesa (Safaricom)
MPESA_CONSUMER_KEY="your_consumer_key"
MPESA_CONSUMER_SECRET="your_consumer_secret"
MPESA_SHORTCODE="your_shortcode"
MPESA_PASSKEY="your_passkey"
MPESA_CALLBACK_URL="https://identafrica.com/api/payments/mpesa/callback"

# ==================== DATABASE ====================
# Supabase PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/dbname"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_anon_key"
SUPABASE_SERVICE_KEY="your_service_key"

# ==================== AUTHENTICATION ====================
# JWT Secret for session tokens
JWT_SECRET="your_super_secret_jwt_key_minimum_32_chars"
JWT_EXPIRES_IN="7d"

# Session Configuration
SESSION_SECRET="your_session_secret"

# ==================== CORS & SECURITY ====================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="https://identafrica.com,https://*.vercel.app,http://localhost:3000,http://localhost:5173"

# ==================== EMAIL ====================
# SMTP Configuration for transactional emails
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your_smtp_user"
SMTP_PASSWORD="your_smtp_password"
SMTP_FROM="noreply@identafrica.com"

# ==================== OPTIONAL SERVICES ====================
# Sentry Error Tracking
VITE_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project"

# Analytics
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ==================== FEATURE FLAGS ====================
ENABLE_AI_PLANNER="true"
ENABLE_PAYMENTS="true"
ENABLE_MPESA="true"
