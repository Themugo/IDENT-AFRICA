# =============================================================================
# IDENT AFRICA - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file or any file containing secrets
# Generate secrets: openssl rand -base64 64
# =============================================================================

# =============================================================================
# APPLICATION MODE
# =============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================
PORT=3001
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRY=86400
SESSION_SECRET=change-this-to-a-strong-session-secret-in-production
PASSWORD_MIN_LENGTH=8
PASSWORD_HISTORY_COUNT=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/ident_africa
DB_POOL_MIN=2
DB_POOL_MAX=10

# =============================================================================
# STORAGE
# =============================================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Cloudinary (production)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=ident-africa

# =============================================================================
# AI SERVICES
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
AI_PLANNER_ENABLED=true
AI_MAX_DESTINATIONS=10

# =============================================================================
# PAYMENT GATEWAYS
# =============================================================================

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_CURRENCY=USD

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_WEBHOOK_SECRET=your-flutterwave-webhook-secret

# M-Pesa
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=your-shortcode
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/mpesa/callback
MPESA_ENV=sandbox

# =============================================================================
# MONETIZATION
# =============================================================================
DEFAULT_COMMISSION_RATE=15
FREE_PLAN_ENABLED=true
TRIAL_DAYS=14

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_AI_PLANNER=true
FEATURE_MOBILE_PAYMENTS=true
FEATURE_REFERRALS=true
FEATURE_LOYALTY=true

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn

# =============================================================================
# CACHE
# =============================================================================
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# =============================================================================
# CDN
# =============================================================================
CDN_URL=https://cdn.identafrical.com
CDN_ENABLED=false

# =============================================================================
# DEVELOPMENT ONLY (do not set in production)
# =============================================================================
ENABLE_DEBUG=false
ENABLE_SWAGGER=true
ENABLE_SEED_DATA=true
