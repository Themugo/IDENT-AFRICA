{
  "name": "ident-africa",
  "private": true,
  "version": "1.0.0",
  "description": "Ident Africa - Luxury East Africa Expeditions & Sanctuaries",
  "author": "Ident Africa Team",
  "license": "UNLICENSED",
  "keywords": [
    "safari",
    "africa",
    "travel",
    "kenya",
    "tanzania",
    "uganda",
    "rwanda",
    "luxury",
    "expedition",
    "wildlife"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Themugo/IDENT-AFRICA.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:frontend": "vite",
    "dev:server": "tsx server.ts",
    "dev:all": "concurrently \"npm run dev:frontend\" \"npm run dev:server\"",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --external:../src/data/mockData --external:../../src/data/mockData --packages=external --outfile=dist/server.mjs",
    "build:full": "npm run build && npm run build:server",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "preview:build": "npm run build && npm run preview",
    "clean": "rm -rf dist",
    "clean:all": "rm -rf dist node_modules/.vite",
    "lint": "tsc --noEmit && eslint src --ext .ts,.tsx",
    "lint:fix": "tsc --noEmit --fix && eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:status": "tsx src/database/status.ts",
    "analyze": "npx vite-bundle-visualizer",
    "test": "echo \"No tests configured\" && exit 0",
    "test:watch": "echo \"No tests configured\" && exit 0"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "uuid": "^14.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "terser": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
